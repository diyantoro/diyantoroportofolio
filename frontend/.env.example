# Origin backend yang dipakai proxy dev server Vite
VITE_API_TARGET=http://localhost:8080

# URL API absolut untuk production (mis. https://api.example.com/api).
# Kosongkan untuk memakai /api same-origin (butuh reverse proxy).
VITE_API_URL=

# Set true untuk mengambil data project dari API Go (fallback ke data statis bila gagal)
VITE_USE_API=false
